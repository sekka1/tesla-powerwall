{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tesla-powerwall",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tesla-powerwall-db",
      "database_id": "23790bef-3817-41cf-9028-a7ff0d1a1a9f",      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TESLA_CLIENT_ID": "c57ddff0-da68-4a49-9f76-750415d87e95",
    "TESLA_REDIRECT_URI": "https://tesla-powerwall.garlandk.workers.dev/auth/callback",
    "TESLA_PUBLIC_KEY": "-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEaHQs+lVCvqblLJ1/o146xTajPhex\nvMNNfZ32sfSMQ9cZcjYX3iapOwI3X7qL08tDRYNoBvX0hHO9CyxwNcaljA==\n-----END PUBLIC KEY-----",
    "TESLA_DOMAIN": "tesla-powerwall.garlandk.workers.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
